    },
    "custom/brand": {
      "format": "♱ <span font_family=\"Noto Sans Symbols 2\">☠</span> kurothepuppy.dev",
      "image-path": "/home/kuro/.config/waybar/kuro-emblem-lavender.svg",
      "icon-size": 16,
