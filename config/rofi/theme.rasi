@import "colors.rasi"

* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: @ivory;
}

window {
    location: center;
    width: 40%;
    padding: 16px;
    border: 1px;
    border-color: @border;
    border-radius: 7px;
    background-color: @obsidian;
}

mainbox { spacing: 12px; children: [ inputbar, listview ]; }
inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 8px;
    border-radius: 4px;
    background-color: @surface;
}
prompt { text-color: @lavender-light; }
listview { lines: 7; spacing: 4px; }
element { padding: 8px; spacing: 8px; border-radius: 4px; }
element selected { background-color: @deep-violet; border: 0 0 0 2px; border-color: @lavender; }
element-icon { size: 16px; }
element-text { vertical-align: 0.5; background-color: inherit; text-color: inherit; }
